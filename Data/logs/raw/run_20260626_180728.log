[2026-06-26 18:07:37] [axEl] IN: pid=81733 role=AXButton → OUT: title=bash cd ~/Desktop/vibe项目/MotionControl && nohup .build/arm64-apple-macosx/debug/MotionControl > /dev/null 2>&1 & sleep 6 echo "=== 进程 ===" ps aux | grep MotionControl | grep -v grep | awk '{print $2, $11}' echo "=== 窗口 ===" osascript -e ' tell application "System Events" set p to first process whose name contains "MotionControl" if p is not missing value then log "windows: " & count of windows of p repeat with w in windows of p log " title=[" & title of w & "] pos=" & position of w & " size=" & size of w end repeat end if end tell ' 2>&1 echo "=== 配置加载 ===" LOG=$(ls -t ~/Desktop/vibe项目/MotionControl/Data/logs/raw/ | head -1) grep -i "配置\|加载\|config\|FPS\|camera\|AVCapture\|startRunning\|notification" ~/Desktop/vibe项目/MotionControl/Data/logs/raw/$LOG 2>/dev/null | head -5 echo "=== 摄像头 ===" log show --predicate 'process == "MotionControl"' --last 1m --style compact 2>/dev/null | grep -i "startRunning\|post notification" | tail -3 frame=(425,701,491,20) (0ms)
