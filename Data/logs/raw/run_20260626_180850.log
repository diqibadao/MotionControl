[2026-06-26 18:08:54] [axEl] IN: pid=81733 role=AXButton → OUT: title=bash # 删掉我写的有问题的 config，让 app 生成正确的默认配置 rm -f ~/Library/Application\ Support/com.motioncontrol/config.json cd ~/Desktop/vibe项目/MotionControl && nohup .build/arm64-apple-macosx/debug/MotionControl > /dev/null 2>&1 & sleep 6 echo "=== 进程 ===" ps aux | grep MotionControl | grep -v grep | awk '{print $2, $11}' echo "=== 窗口 ===" osascript -e ' tell application "System Events" set p to first process whose name contains "MotionControl" if p is not missing value then log "windows: " & count of windows of p repeat with w in windows of p log " title=[" & title of w & "] pos=" & position of w & " size=" & size of w end repeat end if end tell ' 2>&1 frame=(361,701,491,20) (0ms)
