[2026-06-26 18:09:19] [axEl] IN: pid=81733 role=AXButton → OUT: title=bash # 只移窗口位置，不点击 osascript -e ' tell application "System Events" set p to first process whose name contains "MotionControl" set wins to windows of p -- 主窗口移到左侧，不遮盖 set position of (item 2 of wins) to {10, 100} set size of (item 2 of wins) to {960, 700} end tell ' 2>&1 sleep 2 # 截图问 vision screencapture -x /tmp/mc_final3.png python3 -c " import base64, json, urllib.request with open('/tmp/mc_final3.png', 'rb') as f: img_b64 = base64.b64encode(f.read()).decode() data = json.dumps({ 'model': 'Qwen/Qwen3-VL-8B-Instruct', 'messages': [{'role': 'user', 'content': [ {'type': 'image_url', 'image_url': {'url': f'data:image/png;base64,{img_b64}'}}, {'type': 'text', 'text': 'MotionControl窗口左上角的FPS是多少？有没有摄像头画面（显示人脸）？桌面上有没有绿色半透明框蒙层？'} ]}], 'max_tokens': 200 }).encode() req = urllib.request.Request( 'https://api.siliconflow.cn/v1/chat/completions', data=data, headers={'Authorization': 'Bearer sk-gtyiulxrmgpvysbcwbbxpizhoblpckbmioaniqmefwhkmcfk', 'Content-Type': 'application/json'} ) resp = urllib.request.urlopen(req, timeout=30) print(json.loads(resp.read())['choices'][0]['message']['content']) " 2>&1 frame=(900,701,491,20) (0ms)
